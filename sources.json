    "card": "div[class*='job'], article, li",
    "title": "h2, h3, h1, [class*='title']",
    "link": "a[href*='/jobs/']"
  },
  "hitechpros": {
    "enabled": true,
    "name": "HiTechPros Freelance",
    "url": "https://freelance.hitechpros.com/missions",
