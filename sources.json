    "domains": ["hitechpros.com"],
    "pattern": "/missions/\\d+",
    "card": "div[class*='mission'], article, tr, li",
    "title": "h2, h3, a[href*='/missions/']",
    "link": "a[href*='/missions/']"
  },
  "littlebig_connection": {
    "enabled": true,
    "name": "LittleBig Connection",
